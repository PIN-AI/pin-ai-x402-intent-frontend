# Environment Variables Template
# Copy this file to .env.local for development or configure in Vercel for production

# WalletConnect Project ID (Required)
# Get yours at: https://cloud.reown.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# x402 Server URL
# Development: Leave empty to use Vite proxy
# Production: Full URL with protocol (e.g., http://3.17.208.238:3000)
VITE_SERVER_URL=

# Contract Addresses (Base Sepolia Testnet)
VITE_INTENT_MANAGER=your_intent_manager_address
VITE_SUBNET_ID=your_subnet_id
VITE_USDC_ADDRESS=your_usdc_address

# Chain ID
# Base Sepolia: 84532
# Local: 31337
VITE_CHAIN_ID=84532
